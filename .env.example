# Copy to .env and adjust. Real environment variables win over this file.

# Postgres the API talks to. docker compose uses the defaults below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bidding
# Separate database for pytest - it gets truncated on every test.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bidding_test

# Admin portal at /admin. Off unless this is set to 24+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The public server generates its own (deploy/on-boot.sh). Never commit a real key.
ADMIN_KEY=

# A second admin key for judges, kept in the database, shown on the landing page
# and on /config. Full control over lots (within limits); can't change keys.
JUDGE_ACCESS=false
JUDGE_OPEN_LOT_CAP=12
JUDGE_WRITES_PER_MIN=30

# Bidder accounts (email + password). With REQUIRE_LOGIN on, bidding needs an
# account and the bidder name comes from it; watching stays open to everyone.
REQUIRE_LOGIN=false
# Mark the session cookie Secure (HTTPS only). Turn on behind HTTPS.
COOKIE_SECURE=false
SIGNUPS_PER_HOUR=20

# Anti-sniping: a bid in the last N seconds pushes the end back to N seconds
# after it. 0 turns it off.
SOFT_CLOSE_SECONDS=30

# May visitors open lots (local demo), or only the admin (public server)?
PUBLIC_LOT_CREATION=true

# Connection pool size per API instance.
DB_POOL_MIN=2
DB_POOL_MAX=20

# How often each instance looks for auctions past their end time (seconds).
CLOSER_INTERVAL_SECONDS=1

# Messages buffered per WebSocket before a slow client is disconnected.
CLIENT_QUEUE_MAX=256

# Abuse limits (per client address, per API instance). See docs/SECURITY.md.
RATE_LIMITS=true
BID_RATE_PER_SEC=30
BID_BURST=400
WS_CONNECTIONS_PER_IP=50
MAX_BODY_BYTES=16384

# How many proxies in front of the app append to X-Forwarded-For. 0 = ignore
# the header and use the TCP peer (direct access). CloudFront + nginx = 2.
TRUSTED_PROXY_HOPS=0

# Name shown in the admin portal and the floor's network panel.
INSTANCE_NAME=local

# Exposes POST /auctions/{id}/bids/unsafe - a deliberately broken, lock-free
# bid path used only by scripts/race_demo.py to show what goes wrong without
# locking. Never enable in production.
ENABLE_UNSAFE_DEMO=false
UNSAFE_DELAY_MS=20

# Comma-separated origins allowed to call the API from other sites' pages.
# Empty = none (the pages are served by the API itself, so they don't need it).
CORS_ORIGINS=

# Public demo mode: keep at least DEMO_OPEN_LOTS lots open by opening lots
# from a small built-in catalogue, so a shared link never looks empty.
DEMO_RESTOCK=false
DEMO_OPEN_LOTS=4
