# Copy to .env and adjust. Real environment variables win over this file.

# Postgres the API talks to. docker compose uses the defaults below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bidding
# Separate database for pytest - it gets truncated on every test.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bidding_test

# Connection pool size per API instance.
DB_POOL_MIN=2
DB_POOL_MAX=20

# How often each instance looks for auctions past their end time (seconds).
CLOSER_INTERVAL_SECONDS=1

# Messages buffered per WebSocket before a slow client is disconnected.
CLIENT_QUEUE_MAX=256

# Exposes POST /auctions/{id}/bids/unsafe - a deliberately broken, lock-free
# bid path used only by scripts/race_demo.py to show what goes wrong without
# locking. Never enable in production.
ENABLE_UNSAFE_DEMO=false
UNSAFE_DELAY_MS=20

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=*

# Public demo mode: keep at least DEMO_OPEN_LOTS lots open by opening lots
# from a small built-in catalogue, so a shared link never looks empty.
DEMO_RESTOCK=false
DEMO_OPEN_LOTS=4
